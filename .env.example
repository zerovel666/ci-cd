# FastAPI App
APP_ENV=development
DEBUG=true

# Database
POSTGRES_USER=appuser
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=appdb
DATABASE_URL=postgresql://appuser:your_secure_password_here@db:5432/appdb

# API
API_PORT=8000
API_HOST=0.0.0.0

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin_password_here

# Optional: if you need external APIs
# API_KEY=your_api_key_here
# SECRET_KEY=your_secret_key_here
